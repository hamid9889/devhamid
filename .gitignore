# ==============================================================================
# DevHamid Backend - Render Production .gitignore
# Excludes dependencies, cache, environments, media, secrets, and decoupled folders
# ==============================================================================

# Python Cache & Virtual Environments
__pycache__/
*/__pycache__/
venv/
.venv/
env/
*.py[cod]
*$py.class
*.so

# Node Dependencies
node_modules/
*/node_modules/
package-lock.json

# Media, Datasets & Compressed Archives
*.mp4
*.mp3
*.zip
*.tar.gz
*.csv.gz
*.h5
*.hdf5
*.pkl
*.mkv
*.avi
datasets/

# Local Databases
*.db
*.sqlite
*.sqlite3

# Environment Variables & Secrets
.env
.env.*
config/.env
*.env.local

# Local Secrets & Dev Files
.env.development
.env.test

# Build & Distribution Artifacts
build/
dist/
*.egg-info/

# Logs & OS Artifacts
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/
