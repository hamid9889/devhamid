# ==============================================================================
# DevHamid Portfolio - Production Git Ignore Rules
# Excludes dependencies, secrets, local databases, build artifacts, and cache
# ==============================================================================

# Dependencies
node_modules/
*/node_modules/
package-lock.json

# Environment Secrets
.env
.env.*
config/.env
*.env.local
*.env.production

# Python Cache & Virtual Environments
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Local Databases (Supabase is the only persistent DB)
*.db
*.sqlite
*.sqlite3
backend/data/

# OS and Editor Artifacts
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Logs and Diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test and Coverage Outputs
.coverage
htmlcov/
.pytest_cache/

# Temporary test scripts, debug files, and scratch artifacts
test.py
test.js
test.html
test-email.*
test_email.*
test_*.tmp
test-*.tmp
debug*
*debug*
*.tmp
*.temp
# Datasets & Large Media Files
*.csv.gz
*.tar.gz
*.zip
*.h5
*.hdf5
*.pkl
*.parquet
*.mp4
*.mkv
*.avi
datasets/
data_dumps/

